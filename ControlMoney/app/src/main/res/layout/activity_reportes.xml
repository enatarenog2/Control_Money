<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reportes financieros"
            android:textColor="#6D28D9"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conoce el estado de tus finanzas"
            android:textColor="#716B80"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Período del reporte"
            android:textColor="#302443"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spPeriodoReporte"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/fondo_campo"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Balance del período -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_boton_morado"
            android:padding="22dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BALANCE DEL PERÍODO"
                android:textColor="#EDE4FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBalancePeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Q 0.00"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresos menos gastos"
                android:textColor="#EDE4FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Totales financieros -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total de ingresos"
                android:textColor="#716B80"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvIngresosPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Q 0.00"
                android:textColor="#238653"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total de gastos"
                android:textColor="#716B80"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvGastosPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Q 0.00"
                android:textColor="#D14343"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Comparación de los últimos seis meses -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comparación mensual"
            android:textColor="#302443"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresos y gastos de los últimos 6 meses"
            android:textColor="#716B80"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#238653" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Ingresos"
                    android:textColor="#302443"
                    android:textSize="13sp"
                    android:layout_marginEnd="18dp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#6D28D9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Gastos"
                    android:textColor="#302443"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorComparacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Gastos por categoría -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos por categoría"
            android:textColor="#302443"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/contenedorCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnVolverInicioReportes"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#6D28D9"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
