<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reportes financieros"
            android:textColor="#6D28D9"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conoce el estado de tus finanzas"
            android:textColor="#716B80"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Selector del período -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Período del reporte"
            android:textColor="#302443"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spPeriodoReporte"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/fondo_campo"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Balance -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_boton_morado"
            android:padding="22dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BALANCE DEL PERÍODO"
                android:textColor="#EDE4FF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Q 2,500.00"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresos menos gastos"
                android:textColor="#EDE4FF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Ingresos -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total de ingresos"
                android:textColor="#716B80"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Q 4,000.00"
                android:textColor="#238653"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Gastos -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total de gastos"
                android:textColor="#716B80"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Q 1,500.00"
                android:textColor="#D14343"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Distribución por categorías -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos por categoría"
            android:textColor="#302443"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alimentación"
                android:textColor="#302443"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Q 600.00"
                android:textColor="#6D28D9"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="#EDE4FF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transporte"
                android:textColor="#302443"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Q 300.00"
                android:textColor="#6D28D9"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:background="#EDE4FF" />

        </LinearLayout>

        <Button
            android:id="@+id/btnVolverInicioReportes"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#6D28D9"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
